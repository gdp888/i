---
interface Props {
  variant?: 'default' | 'compact' | 'inline';
  title?: string;
  subtitle?: string;
  preset?: string; // preset model name if from card
}
const {
  variant = 'default',
  title = 'Оставить заявку',
  subtitle = 'Перезвоним в течение 15 минут, ответим на вопросы, подберём оптимальную модель',
  preset = '',
} = Astro.props;

const isCompact = variant === 'compact';
---

<section id="lead-form" class="bg-ink-900 text-white relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-brand-500 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-brand-400 blur-3xl"></div>
  </div>

  <div class={`container-page relative ${isCompact ? 'py-12' : 'py-16 md:py-20'}`}>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text -->
      <div>
        <div class="inline-block bg-brand-500/20 text-brand-300 text-xs font-semibold px-3 py-1 rounded-full mb-4 uppercase tracking-wider">
          Бесплатно
        </div>
        <h2 class={`font-bold leading-tight ${isCompact ? 'text-2xl md:text-3xl' : 'text-3xl md:text-4xl'}`}>
          {title}
        </h2>
        <p class="mt-4 text-ink-300 leading-relaxed max-w-md">{subtitle}</p>

        <ul class="mt-8 space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-ink-200">Бесплатный выезд инженера по Москве и МО</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-ink-200">Подберём модель под грунт, УГВ и число проживающих</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-ink-200">Рассрочка 0% на 6 месяцев</span>
          </li>
        </ul>
      </div>

      <!-- Right: Form -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-2xl text-ink-900">
        <form id="lead-form-form" class="space-y-4" action="/api/lead" method="POST">
          {preset && (
            <input type="hidden" name="preset" value={preset} />
          )}
          <div>
            <label for="lead-name" class="block text-sm font-medium text-ink-700 mb-1.5">Имя</label>
            <input
              id="lead-name"
              type="text"
              name="name"
              required
              placeholder="Как к вам обращаться"
              class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-colors"
            />
          </div>
          <div>
            <label for="lead-phone" class="block text-sm font-medium text-ink-700 mb-1.5">Телефон</label>
            <input
              id="lead-phone"
              type="tel"
              name="phone"
              required
              placeholder="+7 (___) ___-__-__"
              class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-colors"
            />
          </div>
          <div>
            <label for="lead-message" class="block text-sm font-medium text-ink-700 mb-1.5">Комментарий <span class="text-ink-400">(необязательно)</span></label>
            <textarea
              id="lead-message"
              name="message"
              rows="3"
              placeholder="Сколько человек в доме, тип грунта, важные детали"
              class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3.5 rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            Отправить заявку
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </button>
          <p class="text-xs text-ink-500 text-center">
            Нажимая кнопку, вы соглашаетесь с <a href="/privacy" class="text-brand-600 hover:underline">политикой конфиденциальности</a>
          </p>
        </form>

        <div id="lead-form-success" class="hidden text-center py-8">
          <div class="w-16 h-16 rounded-full bg-brand-100 mx-auto flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Заявка отправлена!</h3>
          <p class="text-ink-600">Мы свяжемся с вами в течение 15 минут</p>
        </div>

        <div id="lead-form-error" class="hidden text-center py-8">
          <div class="w-16 h-16 rounded-full bg-red-100 mx-auto flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.732 0 2.814-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Ошибка отправки</h3>
          <p class="text-ink-600">Позвоните нам: <a href="tel:+74957927277" class="text-brand-600">+7 (495) 792-72-77</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form-form') as HTMLFormElement;
  const successBlock = document.getElementById('lead-form-success');
  const errorBlock = document.getElementById('lead-form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        body: formData,
      });
      if (!res.ok) throw new Error('Server error');
      form.classList.add('hidden');
      successBlock?.classList.remove('hidden');
    } catch (err) {
      form.classList.add('hidden');
      errorBlock?.classList.remove('hidden');
    }
  });
</script>
