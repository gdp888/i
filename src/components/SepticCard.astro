---
interface Props {
  href: string;
  title: string;
  brand: string;
  people: number;
  price: number;
  priceOld?: number;
  image?: string;
  badge?: string;
  shortDescription?: string;
}
const {
  href,
  title,
  brand,
  people,
  price,
  priceOld,
  image,
  badge,
  shortDescription,
} = Astro.props;

const priceFmt = new Intl.NumberFormat('ru-RU').format(price);
const priceOldFmt = priceOld ? new Intl.NumberFormat('ru-RU').format(priceOld) : null;
---

<a
  href={href}
  class="group flex flex-col bg-white rounded-2xl border border-ink-100 hover:border-brand-300 hover:shadow-lg transition-all overflow-hidden"
>
  <!-- Image -->
  <div class="aspect-[4/3] bg-gradient-to-br from-brand-50 to-brand-100 relative overflow-hidden">
    {badge && (
      <span class="absolute top-3 left-3 z-10 bg-brand-500 text-white text-xs font-semibold px-2.5 py-1 rounded-md">
        {badge}
      </span>
    )}
    {priceOld && (
      <span class="absolute top-3 right-3 z-10 bg-red-500 text-white text-xs font-semibold px-2.5 py-1 rounded-md">
        -{Math.round((1 - price / priceOld) * 100)}%
      </span>
    )}
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-brand-400">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.75v6.75a2.25 2.25 0 002.25 2.25h12a2.25 2.25 0 002.25-2.25V9.75m-16.5 0V6.75A2.25 2.25 0 015.997 4.5h12A2.25 2.25 0 0120.25 6.75v3m-16.5 0h16.5" />
        </svg>
      </div>
    )}
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-4">
    <div class="text-xs text-brand-600 font-semibold uppercase tracking-wider">{brand}</div>
    <h3 class="mt-1 font-bold text-ink-900 text-base group-hover:text-brand-600 transition-colors">{title}</h3>
    {shortDescription && (
      <p class="mt-1 text-sm text-ink-500 line-clamp-2">{shortDescription}</p>
    )}

    <div class="mt-3 flex items-center gap-3 text-sm text-ink-600">
      <span class="inline-flex items-center gap-1">
        <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.125 3.125 0 11-6.25 0 3.125 3.125 0 016.25 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
        {people} чел.
      </span>
    </div>

    <div class="mt-auto pt-4 flex items-end justify-between">
      <div>
        {priceOldFmt && (
          <div class="text-xs text-ink-400 line-through">{priceOldFmt} ₽</div>
        )}
        <div class="text-lg font-bold text-ink-900">{priceFmt} ₽</div>
        <div class="text-xs text-ink-500">под ключ</div>
      </div>
      <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-brand-50 text-brand-600 group-hover:bg-brand-500 group-hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </span>
    </div>
  </div>
</a>
