---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

const faqs = [
  {
    q: 'Сколько стоит монтаж септика под ключ?',
    a: 'Стоимость монтажа зависит от модели септика, типа грунта и удалённости объекта. В среднем — от 25 000 ₽ до 60 000 ₽. Точную смету называем после бесплатного выезда инженера. В цену входят: земляные работы, установка станции, подключение к канализации дома, электропитание, обвязка отвода воды, пуско-наладка.',
  },
  {
    q: 'Какой септик выбрать для дачи?',
    a: 'Для дачи с непостоянным проживанием 1-3 человек подойдут: Малахит НЕРО-2 (накопитель, без электричества, от 49 000 ₽), Тверь 1П (энергонезависимая АОС, от 75 000 ₽), Малахит АИР-3 (АОС с аэрацией, от 89 000 ₽). Если на даче есть электричество и сантехника — лучше АОС. Если электричества нет — накопитель или энергонезависимый септик.',
  },
  {
    q: 'Какой септик ставить, если высокий уровень грунтовых вод (УГВ)?',
    a: 'При высоком УГВ и глинистой почве рекомендуем принудительные модели: Малахит ГЕО-4 (от 132 000 ₽), Евролос Профи, ТОПАС с принудительным отводом. У них усиленный герметичный корпус и насос для отвода очищенной воды. Самотёчные модели при высоком УГВ не работают.',
  },
  {
    q: 'Можно ли установить септик зимой?',
    a: 'Да, можно. Современные АОС устанавливаются при любой температуре. Зимой монтаж чуть дороже из-за сложности земляных работ в мёрзлом грунте. Преимущество зимнего монтажа — нет очереди, быстрее реагируем, выгоднее цены.',
  },
  {
    q: 'Как часто нужно обслуживать септик?',
    a: 'АОС с аэрацией — 1-2 раза в год (откачка избыточного ила, проверка компрессора, чистка фильтров). Септики-отстойники — раз в 6-12 месяцев (откачка ассенизатором). Накопители — по мере заполнения (обычно 1-2 раза в год для дачи, раз в 2-3 месяца для постоянного проживания).',
  },
  {
    q: 'Даёте ли вы гарантию?',
    a: 'Да. Гарантия на корпус станции — 5 лет (по гарантии завода Малахит, 3 года для ТОПАС). На монтажные работы — 2 года. На оборудование (компрессор, насос) — 1-2 года в зависимости от производителя. Бесплатное гарантийное обслуживание.',
  },
  {
    q: 'Можно ли купить септик в рассрочку?',
    a: 'Да, рассрочка 0% на 6 месяцев через банк-партнёр. Без первого взноса, без переплат. Оформление за 15 минут — нужен только паспорт. Также работаем по безналу с НДС для юридических лиц и застройщиков.',
  },
  {
    q: 'Что делать, если септик сломался?',
    a: 'Звоните по телефону +7 (964) 585-34-13. Если на гарантии — выезжаем бесплатно, устраняем причину. Если гарантия закончилась — выезжаем по сервисному тарифу (от 4 500 ₽). Реагируем в течение 24 часов.',
  },
  {
    q: 'Работаете ли вы с юридическими лицами и застройщиками?',
    a: 'Да, активно работаем с застройщиками ИЖС, посёлками, гостиницами и коммерческими объектами. Заключаем договор, работаем с НДС, предоставляем полный пакет документов. Для постоянных партнёров — специальные цены и приоритетный сервис.',
  },
  {
    q: 'В какие районы Москвы и МО вы выезжаете?',
    a: 'Работаем по всей Москве и Московской области. Выезд инженера на замер — бесплатный в радиусе 100 км от МКАД. Дальше — по согласованию. Монтаж — в любом районе МО.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Вопрос-ответ — ИТР Монтаж | Септики в Москве и МО"
  description="Частые вопросы о септиках: какой выбрать, как установить, гарантия, рассрочка, обслуживание. ИТР Монтаж — дилер ИТР."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="py-10 md:py-14 bg-ink-50">
    <div class="container-page">
      <nav class="text-sm text-ink-500 mb-4">
        <a href="/" class="hover:text-brand-600">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-ink-900">Вопрос-ответ</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-ink-900">Вопрос-ответ</h1>
      <p class="mt-3 text-ink-600 max-w-2xl">Собрали самые частые вопросы клиентов. Не нашли ответ? Позвоните +7 (964) 585-34-13 — расскажем.</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-page max-w-3xl">
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group bg-white border border-ink-100 rounded-xl overflow-hidden">
            <summary class="cursor-pointer p-5 font-semibold text-ink-900 flex items-center justify-between gap-4 hover:bg-ink-50 transition-colors">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-brand-500 shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="p-5 pt-0 text-ink-600 leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <LeadForm
    title="Не нашли ответ?"
    subtitle="Задайте вопрос — мы перезвоним и подробно расскажем"
  />
</BaseLayout>
