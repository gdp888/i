---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
---

<BaseLayout
  title="Услуги — монтаж и обслуживание септиков в Москве и МО | ИТР Монтаж"
  description="Монтаж септиков под ключ, обслуживание, шеф-монтаж, бесплатный подбор. Москва и МО. Гарантия 5 лет на корпус."
>
  <section class="py-10 md:py-14 bg-ink-50">
    <div class="container-page">
      <nav class="text-sm text-ink-500 mb-4">
        <a href="/" class="hover:text-brand-600">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-ink-900">Услуги</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-ink-900">Услуги</h1>
      <p class="mt-3 text-ink-600 max-w-2xl">Полный цикл работ по септикам: от бесплатного подбора и выезда инженера до монтажа под ключ и регулярного обслуживания.</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-page">
      <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6">
        {services.map((s) => (
          <a href={`/services/${s.data.slug}`} class="group bg-white rounded-2xl border border-ink-100 hover:border-brand-300 hover:shadow-lg transition-all overflow-hidden flex flex-col md:flex-row">
            <div class="md:w-1/3 aspect-video md:aspect-auto bg-gradient-to-br from-brand-100 to-brand-50 flex items-center justify-center">
              <div class="w-16 h-16 rounded-2xl bg-brand-500 text-white flex items-center justify-center">
                {s.data.icon === 'wrench' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-9.61-9.61a4.5 4.5 0 10-6.364-6.364L3 4.5 4.5 3l.276.276a4.5 4.5 0 006.364 6.364L20.25 18.75 18.75 20.25l-7.33-7.33m1.834 1.834l-1.585-1.586"/></svg>
                )}
                {s.data.icon === 'gear' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.108 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.142-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.781-.929l.149-.894z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                )}
                {s.data.icon === 'user-helmet' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v18m-4.5 0h9M21 12l-4.5-4.5M16.5 7.5L21 12m-4.5-4.5v18m4.5-9h-9"/></svg>
                )}
                {s.data.icon === 'search' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 0z"/></svg>
                )}
              </div>
            </div>
            <div class="md:w-2/3 p-6 flex flex-col">
              <h3 class="font-bold text-ink-900 text-lg group-hover:text-brand-600 transition-colors">{s.data.title}</h3>
              <p class="mt-2 text-sm text-ink-600 leading-relaxed flex-1">{s.data.shortDescription}</p>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-brand-600 font-bold">{s.data.price}</span>
                <span class="text-ink-400 group-hover:text-brand-600 transition-colors inline-flex items-center gap-1 text-sm font-semibold">
                  Подробнее
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LeadForm
    title="Заказать услугу"
    subtitle="Расскажите, что нужно сделать — мы перезвоним и согласуем выезд"
  />
</BaseLayout>
