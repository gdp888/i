---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');

const categoryOrder = [
  'Септики и АОС',
  'Вода и канализация',
  'Инженерные системы',
  'Благоустройство',
];

const categoryDescriptions: Record<string, string> = {
  'Септики и АОС': 'Основная специализация — продажа и монтаж септиков и автономных очистных станций под ключ',
  'Вода и канализация': 'Полный цикл работ по воде: бурение скважин, копка колодцев, разводка, водоочистка, дренаж',
  'Инженерные системы': 'Газификация и отопление загородного дома под ключ',
  'Благоустройство': 'Ворота, заборы, автоматика — обустройство участка и въезда',
};

const grouped = categoryOrder.map((cat) => ({
  category: cat,
  description: categoryDescriptions[cat],
  items: services.filter((s) => s.data.category === cat),
}));
---

<BaseLayout
  title="Услуги — септики, скважины, отопление, благоустройство | ИТР Монтаж"
  description="Полный спектр инженерных услуг для загородного дома: септики и АОС, бурение скважин, водоснабжение, водоочистка, дренаж, газгольдеры, отопление, ворота, заборы, автоматика. Москва и МО."
>
  <section class="py-10 md:py-14 bg-ink-50">
    <div class="container-page">
      <nav class="text-sm text-ink-500 mb-4">
        <a href="/" class="hover:text-brand-600">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-ink-900">Услуги</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-ink-900">Услуги</h1>
      <p class="mt-3 text-ink-600 max-w-2xl">Полный спектр инженерных услуг для загородного дома под ключ — от септика и скважины до ворот и забора. 14 услуг в 4 категориях.</p>
    </div>
  </section>

  <!-- Promo block -->
  <section class="py-6">
    <div class="container-page">
      <div class="bg-gradient-to-r from-brand-600 to-brand-700 text-white rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6">
        <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center shrink-0">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0v3.75m9-3.75h-9m9 3.75h-9"/></svg>
        </div>
        <div class="flex-1">
          <h3 class="text-xl font-bold">Приведи друга — получи от 10 000 ₽</h3>
          <p class="text-brand-50 mt-1">Рекомендуйте нас друзьям и получайте бонусы. Чем больше рекомендаций — тем больше выплаты.</p>
        </div>
        <a href="#lead-form" class="bg-white text-brand-700 font-semibold px-5 py-3 rounded-xl hover:bg-brand-50 transition-colors whitespace-nowrap">
          Узнать подробнее
        </a>
      </div>
    </div>
  </section>

  <!-- Service categories -->
  <section class="py-12 md:py-16">
    <div class="container-page space-y-16">
      {grouped.map((group) => (
        <div id={group.category.toLowerCase().replace(/[^а-яёa-z0-9]/gi, '-')} class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-8 bg-brand-500 rounded"></div>
            <h2 class="text-2xl md:text-3xl font-bold text-ink-900">{group.category}</h2>
          </div>
          <p class="text-ink-600 mb-6 ml-4">{group.description}</p>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {group.items.map((s) => (
              <a href={`/services/${s.data.slug}`} class="group bg-white rounded-2xl border border-ink-100 hover:border-brand-300 hover:shadow-lg transition-all overflow-hidden flex flex-col">
                <div class="p-6 flex-1">
                  <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                    {s.data.icon === 'wrench' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-9.61-9.61a4.5 4.5 0 10-6.364-6.364L3 4.5 4.5 3l.276.276a4.5 4.5 0 006.364 6.364L20.25 18.75 18.75 20.25l-7.33-7.33m1.834 1.834l-1.585-1.586"/></svg>
                    )}
                    {s.data.icon === 'gear' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.108 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.142-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.781-.929l.149-.894z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    )}
                    {s.data.icon === 'user-helmet' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v18m-4.5 0h9M21 12l-4.5-4.5M16.5 7.5L21 12m-4.5-4.5v18m4.5-9h-9"/></svg>
                    )}
                    {s.data.icon === 'search' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 0z"/></svg>
                    )}
                    {s.data.icon === 'water' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.892 13.392l-7.5 11.025a.75.75 0 01-1.286 0l-7.5-11.025a8.25 8.25 0 1116.286 0z"/></svg>
                    )}
                    {s.data.icon === 'water-drop' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0-13.5v9m0-9l-3 3m3-3l3 3"/></svg>
                    )}
                    {s.data.icon === 'filter' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M6 12h12M9 19.5h6"/></svg>
                    )}
                    {s.data.icon === 'flame' || s.data.icon === 'fire' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z"/></svg>
                    )}
                    {s.data.icon === 'wave' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12c1.5 0 1.5-2 3-2s1.5 2 3 2 1.5-2 3-2 1.5 2 3 2 1.5-2 3-2 1.5 2 3 2M3 18c1.5 0 1.5-2 3-2s1.5 2 3 2 1.5-2 3-2 1.5 2 3 2 1.5-2 3-2 1.5 2 3 2M3 6c1.5 0 1.5-2 3-2s1.5 2 3 2 1.5-2 3-2 1.5 2 3 2 1.5-2 3-2 1.5 2 3 2"/></svg>
                    )}
                    {s.data.icon === 'bucket' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3l1.5 4.5L6 21h12l1.5-13.5L21 3M3 3h18M9 9c0 1.657.895 3 2 3s2-1.343 2-3-0.895-3-2-3-2 1.343-2 3z"/></svg>
                    )}
                    {s.data.icon === 'gate' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21V5a2 2 0 012-2h6v18M21 21V5a2 2 0 00-2-2h-6v18M3 21h18M7 9h2M7 13h2M7 17h2M15 9h2M15 13h2M15 17h2"/></svg>
                    )}
                    {s.data.icon === 'fence' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10l3-3 3 3v11M9 10l3-3 3 3v11M15 10l3-3 3 3v11M3 10v11M9 10v11M15 10v11M21 10v11M3 21h18"/></svg>
                    )}
                    {s.data.icon === 'chip' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5v3m3-3v3m-6 0v3m9-3v3m-12 0v3m15-3v3m-15 3v3m15-3v3M6 7.5h12a2 2 0 012 2v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5a2 2 0 012-2zM9 11h6v3H9v-3z"/></svg>
                    )}
                  </div>
                  <h3 class="font-bold text-ink-900 text-lg group-hover:text-brand-600 transition-colors">{s.data.title}</h3>
                  <p class="mt-2 text-sm text-ink-600 leading-relaxed flex-1">{s.data.shortDescription}</p>
                </div>
                <div class="px-6 py-4 border-t border-ink-100 flex items-center justify-between">
                  <span class="text-brand-600 font-bold text-sm">{s.data.price}</span>
                  <span class="text-ink-400 group-hover:text-brand-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <LeadForm
    title="Заказать услугу"
    subtitle="Расскажите, что нужно сделать — мы перезвоним и согласуем выезд"
  />
</BaseLayout>
