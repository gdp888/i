---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

const installations = [
  { brand: 'Малахит', location: 'Истринский р-н, д. Лужки', date: 'Июль 2025', model: 'Малахит АИР-5', description: 'Монтаж АОС для частного дома постоянного проживания 5 человек' },
  { brand: 'ТОПАС', location: 'Подольский р-н, д. Львово', date: 'Июнь 2025', model: 'ТОПАС 4', description: 'Установка АОС для дачи с непостоянным проживанием' },
  { brand: 'Юнилос Астра', location: 'Красногорский р-н, д. Губайлово', date: 'Май 2025', model: 'Астра 5', description: 'Замена старого септика на АОС для загородного дома' },
  { brand: 'Малахит ГЕО', location: 'Чеховский р-н, д. Венково', date: 'Май 2025', model: 'Малахит ГЕО-4', description: 'Монтаж на участке с высоким УГВ и глинистой почвой' },
  { brand: 'Евролос', location: 'Ленинский р-н, д. Картино', date: 'Апрель 2025', model: 'Евролос Био 5', description: 'Установка АОС с самотёчным отводом воды' },
  { brand: 'Тверь', location: 'Раменский р-н, д. Дергаево', date: 'Апрель 2025', model: 'Тверь 1П', description: 'Энергонезависимая АОС для дачи без электричества' },
  { brand: 'БиоДека', location: 'Наро-Фоминский р-н, д. Апалино', date: 'Март 2025', model: 'БиоДека 5', description: 'Горизонтальная АОС для дома 5 человек' },
  { brand: 'ТОПАС', location: 'Одинцовский р-н, д. Акулово', date: 'Март 2025', model: 'ТОПАС 8', description: 'АОС для большой семьи и гостевого дома' },
  { brand: 'Малахит', location: 'Дмитровский р-н, д. Дядьково', date: 'Февраль 2025', model: 'Малахит АИР-3', description: 'Монтаж АОС для дачи 3 человек' },
  { brand: 'Малахит НЕРО', location: 'Солнечногорский р-н, д. Пешки', date: 'Февраль 2025', model: 'Малахит НЕРО-2', description: 'Накопительная ёмкость для дачи с непостоянным проживанием' },
  { brand: 'Юнилос Астра', location: 'Рузский р-н, д. Тучково', date: 'Январь 2025', model: 'Астра 8', description: 'АОС для большого дома с 3 санузлами' },
  { brand: 'ТОПАС', location: 'Сергиево-Посадский р-н, д. Торгашино', date: 'Январь 2025', model: 'ТОПАС 5', description: 'Замена выгребной ямы на АОС' },
];

const brands = [...new Set(installations.map((i) => i.brand))].sort();
const stats = [
  { value: '23+', label: 'объекта смонтировано' },
  { value: '18', label: 'брендов установлено' },
  { value: '100%', label: 'договоров с гарантией' },
  { value: '1 день', label: 'средний срок монтажа' },
];
---

<BaseLayout
  title="Наши работы — монтаж септиков в Москве и МО | ИТР Монтаж"
  description="Портфолио установок септиков: Малахит, ТОПАС, Юнилос Астра, Евролос, Тверь и др. Реальные объекты по Москве и МО с фотографиями и описанием."
>
  <section class="py-10 md:py-14 bg-ink-50">
    <div class="container-page">
      <nav class="text-sm text-ink-500 mb-4">
        <a href="/" class="hover:text-brand-600">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-ink-900">Наши работы</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-ink-900">Наши работы</h1>
      <p class="mt-3 text-ink-600 max-w-2xl">Реальные объекты по Москве и МО. Все монтажи выполнены нашей бригадой с гарантией 5 лет на корпус.</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-10 bg-white border-b border-ink-100">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((s) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-brand-500">{s.value}</div>
            <div class="text-sm text-ink-600 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Filter -->
  <section class="py-6 bg-white border-b border-ink-100 sticky top-16 md:top-20 z-30">
    <div class="container-page flex flex-wrap gap-2">
      <button data-filter="" class="filter-btn active px-4 py-2 text-sm font-medium rounded-full bg-brand-500 text-white">
        Все
      </button>
      {brands.map((b) => (
        <button data-filter={b} class="filter-btn px-4 py-2 text-sm font-medium rounded-full bg-ink-50 hover:bg-brand-50 hover:text-brand-700 text-ink-700 transition-colors">
          {b}
        </button>
      ))}
    </div>
  </section>

  <!-- Grid -->
  <section class="py-12 md:py-16">
    <div class="container-page">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {installations.map((inst) => (
          <article data-brand={inst.brand} class="installation-card group bg-white rounded-2xl border border-ink-100 overflow-hidden hover:border-brand-300 hover:shadow-lg transition-all">
            <div class="aspect-[4/3] bg-gradient-to-br from-brand-100 to-brand-50 relative overflow-hidden">
              <!-- Placeholder for real photo -->
              <div class="absolute inset-0 flex items-center justify-center text-brand-300">
                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M2.25 18a2.25 2.25 0 002.25 2.25h15a2.25 2.25 0 002.25-2.25V6a2.25 2.25 0 00-2.25-2.25H4.5A2.25 2.25 0 002.25 6v12z"/></svg>
              </div>
              <span class="absolute top-3 left-3 bg-brand-500 text-white text-xs font-semibold px-2.5 py-1 rounded-md">
                {inst.brand}
              </span>
            </div>
            <div class="p-5">
              <div class="text-xs text-ink-500">{inst.date}</div>
              <h3 class="mt-1 font-bold text-ink-900 group-hover:text-brand-600 transition-colors">{inst.model}</h3>
              <p class="mt-2 text-sm text-ink-600 leading-relaxed">{inst.description}</p>
              <div class="mt-3 pt-3 border-t border-ink-100 flex items-center gap-1.5 text-sm text-ink-500">
                <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                {inst.location}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <LeadForm
    title="Хотите так же?"
    subtitle="Оставьте заявку — подберём модель и согласуем выезд"
  />
</BaseLayout>

<script>
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.installation-card');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      btns.forEach((b) => {
        b.classList.remove('bg-brand-500', 'text-white', 'active');
        b.classList.add('bg-ink-50', 'text-ink-700');
      });
      btn.classList.remove('bg-ink-50', 'text-ink-700');
      btn.classList.add('bg-brand-500', 'text-white', 'active');

      cards.forEach((c) => {
        const card = c as HTMLElement;
        if (!filter || card.dataset.brand === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
