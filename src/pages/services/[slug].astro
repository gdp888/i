---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({
    params: { slug: s.data.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<BaseLayout
  title={`${service.data.title} — Москва и МО | ИТР Монтаж`}
  description={service.data.shortDescription}
>
  <section class="py-10 md:py-14 bg-ink-50">
    <div class="container-page">
      <nav class="text-sm text-ink-500 mb-4">
        <a href="/" class="hover:text-brand-600">Главная</a>
        <span class="mx-2">/</span>
        <a href="/services" class="hover:text-brand-600">Услуги</a>
        <span class="mx-2">/</span>
        <span class="text-ink-900">{service.data.title}</span>
      </nav>
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl bg-brand-500 text-white flex items-center justify-center shrink-0">
          {service.data.icon === 'wrench' && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-9.61-9.61a4.5 4.5 0 10-6.364-6.364L3 4.5 4.5 3l.276.276a4.5 4.5 0 006.364 6.364L20.25 18.75 18.75 20.25l-7.33-7.33m1.834 1.834l-1.585-1.586"/></svg>
          )}
          {service.data.icon === 'gear' && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.108 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.142-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.781-.929l.149-.894z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          )}
          {service.data.icon === 'user-helmet' && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v18m-4.5 0h9M21 12l-4.5-4.5M16.5 7.5L21 12m-4.5-4.5v18m4.5-9h-9"/></svg>
          )}
          {service.data.icon === 'search' && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 0z"/></svg>
          )}
        </div>
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-ink-900">{service.data.title}</h1>
          <p class="mt-2 text-ink-600">{service.data.shortDescription}</p>
          <div class="mt-3 inline-block bg-brand-100 text-brand-700 font-bold px-4 py-1.5 rounded-lg">
            {service.data.price}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-page grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 prose prose-ink max-w-none">
        <Content />
      </div>

      {service.data.steps.length > 0 && (
        <aside>
          <div class="bg-white border border-ink-100 rounded-2xl p-6 sticky top-24">
            <h3 class="font-bold text-ink-900 mb-4">Как проходит</h3>
            <ol class="space-y-4">
              {service.data.steps.map((step, idx) => (
                <li class="flex gap-3">
                  <span class="shrink-0 w-7 h-7 rounded-full bg-brand-500 text-white font-bold text-sm flex items-center justify-center">
                    {idx + 1}
                  </span>
                  <div>
                    <div class="font-semibold text-ink-900">{step.title}</div>
                    <p class="text-sm text-ink-600 mt-0.5">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )}
    </div>
  </section>

  <LeadForm
    title={`Заказать: ${service.data.title}`}
    subtitle="Оставьте заявку — рассчитаем стоимость и согласуем дату"
    preset={service.data.title}
  />
</BaseLayout>
